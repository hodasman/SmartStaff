# Режим отладки. На продакшене ОБЯЗАТЕЛЬНО False
DJANGO_DEBUG=False

# Секретный ключ Django (сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(50))")
SECRET_KEY=change-me

# Хосты через запятую (на продакшене укажите ваш домен)
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,0.0.0.0

# Сервер исходящей почты (SMTP)
# Для разработки с самоподписанными сертификатами можно оставить кастомный бэкенд,
# на продакшене лучше: django.core.mail.backends.smtp.EmailBackend
EMAIL_BACKEND=authapp.backends.email_backend.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-mail@gmail.com
# Пароль приложения Google: https://myaccount.google.com/apppasswords
EMAIL_HOST_PASSWORD=change-me
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
# Почта, на которую уходят уведомления админу
EMAIL_ADMIN=admin@example.com

# ---- Для деплоя (Railway/Render и т.п.) ----
# Путь к примонтированному тому для медиафайлов ( Railway: /data/media )
# MEDIA_ROOT=/data/media
# Путь к файлу SQLite, если не используется Postgres ( Railway: /data/db.sqlite3 )
# SQLITE_PATH=/data/db.sqlite3
# Если используется Postgres - переменную DATABASE_URL задаст платформа
