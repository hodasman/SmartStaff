#: authapp/tasks.py:37
#, python-format
msgid ""
"Thank you for registering on the site %(site_name)s.\n"
"To activate your account, please follow the link:\n"
"%(link)s\n"
msgstr ""
"Дзякуй за рэгістрацыю на сайце %(site_name)s.\n"
"Каб актываваць уліковы запіс, калі ласка, перайдзіце па спасылцы:\n"
"%(link)s\n"

#: authapp/tasks.py:59
msgid "Confirm your new email address"
msgstr "Пацвердзіце ваш новы email"

#: authapp/tasks.py:61
#, python-format
msgid ""
"You (or someone) requested changing the email address for your account on "
"%(site_name)s to %(new_email)s.\n"
"To confirm the new address, please follow the link:\n"
"%(link)s\n"
"If you did not request this, just ignore this email — your current address "
"will remain unchanged.\n"
msgstr ""
"Вы (або хтосьці іншы) запатрабавалі змену email-адраса для вашага акаўнта на "
"сайце %(site_name)s на %(new_email)s.\n"
"Каб пацвердзіць новы адрас, перайдзіце па спасылцы:\n"
"%(link)s\n"
"Калі вы не запытвалі змену — проста праігнаруйце гэты ліст, бягучы адрас "
"застанецца без змяненняў.\n"

